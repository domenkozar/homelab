Subject: [PATCH] usb: typec: ucsi: acpi: Assume UCSI 1.2 on Yoga Slim 7 14APU8

The Lenovo Yoga Slim 7 14APU8 (83AA), BIOS M6CN44WW, reports a zero
UCSI version. A return probe confirmed read_version succeeds with zero,
then ucsi_register and ucsi_acpi_probe return -ENODEV. Its UsbCTabl SSDT
read method copies MESSAGE_IN and CCI without initializing VERSION.

Adapt the upstream Acer Nitro ANV15-41 workaround by Pannarat
Wiriyaarritham.
Assume UCSI 1.2 only for this Lenovo model when VERSION is zero; preserve
nonzero versions and read errors. Retain the 7.2 message-out operation.

Experimental: controller initialization and charging behavior still need
hardware validation. This does not establish a fix for intermittent
charging with the Samsung S32BM702UU.

Prepared with assistance from OpenAI Codex.

Link: https://git.kernel.org/linus/8c51ea651d043c786c37668c51624bd6b338a0ef

---
diff --git a/drivers/usb/typec/ucsi/ucsi_acpi.c b/drivers/usb/typec/ucsi/ucsi_acpi.c
--- a/drivers/usb/typec/ucsi/ucsi_acpi.c
+++ b/drivers/usb/typec/ucsi/ucsi_acpi.c
@@ -121,6 +121,33 @@
 	.async_control = ucsi_acpi_async_control
 };
 
+static int ucsi_lenovo_read_version(struct ucsi *ucsi, u16 *version)
+{
+	struct ucsi_acpi *ua = ucsi_get_drvdata(ucsi);
+	int ret;
+
+	ret = ucsi_acpi_read_version(ucsi, version);
+	if (ret)
+		return ret;
+
+	if (!*version) {
+		dev_warn(ua->dev, "UCSI version is zero, assuming 1.2\n");
+		*version = UCSI_VERSION_1_2;
+	}
+
+	return 0;
+}
+
+static const struct ucsi_operations ucsi_lenovo_ops = {
+	.read_version = ucsi_lenovo_read_version,
+	.read_cci = ucsi_acpi_read_cci,
+	.poll_cci = ucsi_acpi_poll_cci,
+	.read_message_in = ucsi_acpi_read_message_in,
+	.write_message_out = ucsi_acpi_write_message_out,
+	.sync_control = ucsi_sync_control_common,
+	.async_control = ucsi_acpi_async_control
+};
+
 static int ucsi_gram_sync_control(struct ucsi *ucsi, u64 command, u32 *cci,
 				  void *val, size_t len, void *msg_out,
 				  size_t msg_out_size)
@@ -162,6 +189,14 @@
 };
 
 static const struct dmi_system_id ucsi_acpi_quirks[] = {
+	{
+		.matches = {
+			DMI_EXACT_MATCH(DMI_SYS_VENDOR, "LENOVO"),
+			DMI_EXACT_MATCH(DMI_PRODUCT_NAME, "83AA"),
+			DMI_EXACT_MATCH(DMI_PRODUCT_VERSION, "Yoga Slim 7 14APU8"),
+		},
+		.driver_data = (void *)&ucsi_lenovo_ops,
+	},
 	{
 		.matches = {
 			DMI_MATCH(DMI_SYS_VENDOR, "LG Electronics"),
